# 数据库：默认 SQLite（backend/data/app.db）；生产用 PostgreSQL 16 + pgvector
# docker compose up -d 起基础设施后，用下面这行：
# DATABASE_URL=postgresql+psycopg2://ai_team:ai_team@localhost:5432/ai_team_os
DATABASE_URL=

# SSE 事件总线跨进程通道：设置后启用 Redis pub/sub（多 worker 部署需要）；
# 留空 = 单进程内存队列。redis: redis://localhost:6379/0
REDIS_URL=

# Model Gateway（OpenAI 兼容）。留空 LLM_API_KEY 时自动降级为本地模拟，闭环仍可跑通。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 演示节奏：每个步骤耗时（秒）
STEP_DELAY=1.2
